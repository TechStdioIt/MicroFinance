# ==========================================
# EduSubmit Project .gitignore
# Covers .NET Core Backend & Next.js Frontend
# ==========================================

# --- .NET / C# / Visual Studio / Rider ---
## Build results
**/bin/
**/obj/
**/out/
*.exe
*.dll
*.pdb
*.cache

## User & IDE files
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

## NuGet & Package cache
packages/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

## Logs and diagnostic files
*.log
*.err
*.tmp
*.temp
TestResults/
*.trx


secrets.json
*.env
*.env.*
!.env.example

## Database files (if any local file databases are generated)
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf

# --- Node.js / Next.js Frontend ---
node_modules/
.next/
out/
build/
dist/
.cache/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.lcov
.vercel/
.turbo/

